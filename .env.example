# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
# Never commit .env. Generate each password and token with:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-43

COMPOSE_PROJECT_NAME=heimkunnskap

# --- Database (created on the first start of an empty volume) ---
POSTGRES_ADMIN_PASSWORD=
HEIM_DB=heimkunnskap
HEIM_DB_USER=heimkunnskap
# Owner login: the worker and the web app
DB_PASS=
# Read-only login: Grafana, the whole report schema
DB_PASS_RO=
# Claude connector login: only the report views in MCP_VIEWS
DB_PASS_MCP=

# --- Enable Banking (docs/enable-banking.md) ---
# The production application id. The private key is not here: it is the
# file eb-key.pem in SECRETS_DIR.
EB_APP_ID=
# Short name = Enable Banking's bank name : country
BANKS=DNB=DNB:NO,SAS=SAS EuroBonus Mastercard:NO
# The sole proprietorship's income account (11 digits or IBAN). Every
# deposit there counts as business income. Comma-separated if several.
BUSINESS_INCOME_ACCOUNTS=
# Local time of the nightly sync (TIMEZONE, default Europe/Oslo)
# Keep it clear of the server's automatic reboot window (unattended-upgrades'
# Automatic-Reboot-Time) and the backup. A sync cut short is retried, and a
# worker started after this time catches up on a missed sync.
SYNC_AT=03:15

# --- Web app ---
PUBLIC_URL=https://heim.example.org
# Signs the session cookie that carries the BankID flow
WEB_SECRET_KEY=
# Who may open the web app (Apache checks this too). Home LAN, WireGuard,
# and the home's public address: LAN clients reach heim.example.org through
# the router, so Apache sees them coming from it.
WEB_ALLOWED_NETWORKS=192.168.1.0/24,10.8.0.0/24,203.0.113.7/32
WEB_PORT=4200

# --- Claude connector ---
# Off while empty. When set, give the same value to the connector in Claude.
MCP_TOKEN=
# Report views Claude may read. Add "transactions" to share individual
# transactions and merchants; leave it out to share totals only. "*" shares
# every report view, including ones added later.
MCP_VIEWS=accounts,monthly,balances,consents,imports,household_monthly,review,category_monthly,category_rules,lending,tax_estimate,payslips,expense_claims,business_expenses,vat_terms,eurobonus,points_monthly,points_purchases

# --- Mail intake (heimkunnskap/mailin.py) ---
# The dedicated Gmail address the worker reads over IMAP. Off while empty.
# Its app password is the file gmail-app-password in SECRETS_DIR, not here.
MAIL_USER=
# Only mail from these addresses, passing Gmail's sender checks, is used
MAIL_ALLOWED_SENDERS=
MAIL_POLL_SECONDS=300

# --- Files on the host ---
# eb-key.pem (Enable Banking private key), pushover (two lines: token=<app
# API token> and user=<user key>) and gmail-app-password (one line; an empty file while mail
# intake is off). All root-only: chmod 600, directory chmod 700.
SECRETS_DIR=/srv/heimkunnskap/secrets

# --- Grafana (compose profile "grafana", at <PUBLIC_URL>/grafana/) ---
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001
