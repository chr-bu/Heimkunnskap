    {
      "id": 4,
      "type": "stat",
      "title": "Days until a BankID consent ends",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heimkunnskap"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heimkunnskap"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT min(days_left) AS days_left FROM report.consents WHERE status = 'active'"
        }
      ],
