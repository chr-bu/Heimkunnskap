    {
      "id": 6,
      "type": "table",
      "title": "Money out per account, last 12 full months",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heimkunnskap"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heimkunnskap"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT account AS \"Account\", sum(money_out) AS \"Out, 12 months\", sum(money_in) AS \"In, 12 months\",\n       round(sum(money_out) / 12, 0) AS \"Out per month\"\nFROM report.monthly\nWHERE month >= (date_trunc('month', now()) - interval '12 months')::date\n  AND month < date_trunc('month', now())::date\nGROUP BY account\nHAVING sum(money_out) > 0\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyNOK",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Account"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Largest payees, last 90 days",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heimkunnskap"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heimkunnskap"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(counterparty, split_part(description, ',', 1)) AS \"Paid to\",\n       count(*) AS \"Payments\", -sum(amount) AS \"Total\"\nFROM report.transactions\nWHERE kind IS NULL AND amount < 0\n  AND booking_date >= (now() - interval '90 days')::date\nGROUP BY 1\nORDER BY 3 DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyNOK",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Paid to"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Payments"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Spending by category, this year",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heimkunnskap"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heimkunnskap"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT category AS \"Category\", sum(spending) AS \"This year\",\n       round(sum(spending) / greatest(1, extract(month FROM now())), 0) AS \"Per month\"\nFROM report.category_monthly\nWHERE month >= date_trunc('year', now())::date\nGROUP BY category\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyNOK",
          "decimals": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Per month"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "Category",
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Categories per month, last 12 months",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heimkunnskap"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heimkunnskap"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT to_char(month, 'YYYY-MM') AS \"Month\", category, spending\nFROM report.category_monthly\nWHERE month >= (date_trunc('month', now()) - interval '11 months')::date\nORDER BY month, sort_order"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "Month",
            "rowField": "category",
            "valueField": "spending"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyNOK",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "category\\Month"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "displayName",
                "value": "Category"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Moves with no other side found, last 180 days",
      "description": "A card bill whose card file is not uploaded yet, or a card credit with no bill found.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heimkunnskap"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heimkunnskap"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT booking_date AS \"Date\", account AS \"Account\", amount AS \"Amount\",\n       description AS \"Description\", rule AS \"Rule\"\nFROM report.review\nWHERE booking_date >= (now() - interval '180 days')::date\nORDER BY booking_date DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Amount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyNOK"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ],
