            "uid": "heimkunnskap"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(avg(spending), 0) AS spending FROM report.household_monthly\nWHERE month >= (date_trunc('month', now()) - interval '12 months')::date\n  AND month < date_trunc('month', now())::date"
        }
      ],
